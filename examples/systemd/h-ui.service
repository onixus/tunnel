# /etc/systemd/system/h-ui.service
[Unit]
Description=Hysteria 2 management panel
After=network-online.target wg-quick@wg-private.service
Wants=network-online.target wg-quick@wg-private.service
Conflicts=hysteria-server.service
[Service]
User=hysteria
Group=hysteria
WorkingDirectory=/var/lib/h-ui
ExecStart=/usr/local/bin/h-ui -p 8081
Restart=on-failure
RestartSec=3
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/h-ui
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=65536
[Install]
WantedBy=multi-user.target
