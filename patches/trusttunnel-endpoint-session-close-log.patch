+//! Runs without the libtest harness: the harness starts threads before a test body runs,
+//! and SIGTERM must be blocked before any thread exists. The binary re-executes itself
+//! as the child process under test.
+
+use std::io::{BufRead, BufReader, Read};
+use std::os::unix::process::ExitStatusExt;
+use std::process::{Command, Stdio};
+use std::time::Duration;
+use trusttunnel::{log_utils, termination};
+
+const CHILD_ENV: &str = "TT_SIGTERM_CHILD";
+const LOG_FILE_ENV: &str = "TT_SIGTERM_LOG_FILE";
+const SUMMARY: &str = "Shutdown (SIGTERM): 3 sessions closed";
+
+fn main() {
+    match std::env::var(CHILD_ENV) {
+        Ok(mode) => child(&mode),
+        Err(_) => parent(),
+    }
+}
+
+fn child(mode: &str) {
+    termination::block_sigterm().unwrap();
+    let log_file = std::env::var(LOG_FILE_ENV).ok();
+    log::set_logger(match &log_file {
+        None => log_utils::make_stdout_logger(),
+        Some(path) => log_utils::make_file_logger(path).unwrap(),
+    })
+    .unwrap();
+    log::set_max_level(log::LevelFilter::Info);
+    termination::spawn_sigterm_handler(|| SUMMARY.to_string()).unwrap();
+
+    let rt = tokio::runtime::Builder::new_multi_thread()
+        .worker_threads(2)
+        .enable_all()
+        .build()
+        .unwrap();
+    rt.block_on(async {
+        if mode == "busy" {
+            for _ in 0..2 {
+                tokio::spawn(async {
+                    loop {
+                        std::thread::sleep(Duration::from_secs(1));
+                    }
+                });
+            }
+        }
+        println!("READY");
+        if mode == "busy" {
+            loop {
+                std::thread::sleep(Duration::from_secs(1));
+            }
+        }
+        std::future::pending::<()>().await
+    });
+}
+
+fn run_child(mode: &str, log_file: Option<&std::path::Path>) -> (std::process::ExitStatus, String) {
+    let mut cmd = Command::new(std::env::current_exe().unwrap());
+    cmd.env(CHILD_ENV, mode).stdout(Stdio::piped());
+    if let Some(path) = log_file {
+        cmd.env(LOG_FILE_ENV, path);
+    }
+    let mut child = cmd.spawn().unwrap();
+    let mut stdout = BufReader::new(child.stdout.take().unwrap());
+    let mut line = String::new();
+    loop {
+        line.clear();
+        assert_ne!(
+            stdout.read_line(&mut line).unwrap(),
+            0,
+            "child exited early"
+        );
+        if line.trim() == "READY" {
+            break;
+        }
+    }
+    // SAFETY: plain kill(2) on the child we spawned
+    assert_eq!(
+        unsafe { libc::kill(child.id() as libc::pid_t, libc::SIGTERM) },
+        0
+    );
+    let mut rest = String::new();
+    stdout.read_to_string(&mut rest).unwrap();
+    (child.wait().unwrap(), rest)
+}
+
+fn check(name: &str, mode: &str, use_log_file: bool) {
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("endpoint.log");
+    let (status, stdout) = run_child(mode, use_log_file.then_some(path.as_path()));
+    assert_eq!(
+        status.signal(),
+        Some(libc::SIGTERM),
+        "{}: unexpected status {:?}",
+        name,
+        status
+    );
+    let output = if use_log_file {
+        std::fs::read_to_string(&path).unwrap()
+    } else {
+        stdout
+    };
+    assert!(output.contains(SUMMARY), "{}: output {:?}", name, output);
+    println!("test {} ... ok", name);
+}
+
+fn parent() {
+    check("sigterm_idle_runtime_stdout", "idle", false);
+    check("sigterm_busy_runtime_stdout", "busy", false);
+    check("sigterm_busy_runtime_log_file", "busy", true);
+}
