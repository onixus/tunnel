diff --git a/lib/src/session_log.rs b/lib/src/session_log.rs
new file mode 100644
index 0000000..202c582
--- /dev/null
+++ b/lib/src/session_log.rs
@@ -0,0 +1,562 @@
+use crate::settings::Settings;
+use crate::tls_demultiplexer::Protocol;
+use std::fmt::{Display, Formatter};
+use std::io;
+use std::io::ErrorKind;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+const H3_NO_ERROR: u64 = 0x100;
+const QUIC_CRYPTO_ERRORS: std::ops::RangeInclusive<u64> = 0x100..=0x1ff;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum Side {
+    Client,
+    Server,
+}
+
+/// Why a client session (one HTTP/2 or HTTP/3 connection carrying a tunnel) ended
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) enum CloseReason {
+    /// Orderly close: EOF, GOAWAY or CONNECTION_CLOSE without an error code
+    PeerClosed { code: Option<u64> },
+    /// Transport reset or aborted by the client side
+    PeerReset,
+    /// No new tunnel requests within `client_listener_timeout`
+    IdleTimeout(Duration),
+    /// QUIC idle timeout expired: no packets from the client within `max_idle_timeout`
+    QuicIdleTimeout(Duration),
+    /// TCP keepalive probes went unanswered
+    KeepaliveTimeout,
+    /// TLS / QUIC crypto error
+    TlsError { by: Side, code: Option<u64> },
+    /// HTTP/2 GOAWAY or QUIC CONNECTION_CLOSE with an error code
+    ProtocolError { by: Side, code: u64, app: bool },
+    /// The endpoint is shutting down or restarting
+    Shutdown,
+    /// The session was closed because its credentials were rejected
+    AuthRejected(&'static str),
+    /// Any other I/O error
+    Io(ErrorKind),
+}
+
+/// Details of a closed QUIC connection, carried as the payload of the [`io::Error`]
+/// returned when the connection is closed
+#[derive(Debug, Default, Clone)]
+pub(crate) struct QuicCloseInfo {
+    pub timed_out: bool,
+    pub idle_timeout: Duration,
+    /// (is_app, error_code)
+    pub peer_error: Option<(bool, u64)>,
+    pub local_error: Option<(bool, u64)>,
+}
+
+impl Display for QuicCloseInfo {
+    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
+        write!(f, "QUIC connection closed: {:?}", self)
+    }
+}
+
+impl std::error::Error for QuicCloseInfo {}
+
+impl QuicCloseInfo {
+    pub fn into_io_error(self) -> io::Error {
+        io::Error::new(ErrorKind::UnexpectedEof, self)
+    }
+
+    fn reason(&self) -> CloseReason {
+        if self.timed_out {
+            return CloseReason::QuicIdleTimeout(self.idle_timeout);
+        }
+        let by_error = |side, (app, code): (bool, u64)| match (app, code) {
+            (false, 0) | (true, H3_NO_ERROR) | (true, 0) if side == Side::Client => {
+                CloseReason::PeerClosed { code: Some(code) }
+            }
+            (false, c) if QUIC_CRYPTO_ERRORS.contains(&c) => CloseReason::TlsError {
+                by: side,
+                code: Some(c),
+            },
+            (app, code) => CloseReason::ProtocolError {
+                by: side,
+                code,
+                app,
+            },
+        };
+        match (self.peer_error, self.local_error) {
+            (Some(e), _) => by_error(Side::Client, e),
+            (None, Some(e)) => by_error(Side::Server, e),
+            (None, None) => CloseReason::PeerClosed { code: None },
+        }
+    }
+}
+
+impl CloseReason {
+    /// Classify an error which ended the session listener
+    pub fn from_io_error(e: &io::Error) -> Self {
+        if let Some(inner) = e.get_ref() {
+            if let Some(quic) = inner.downcast_ref::<QuicCloseInfo>() {
+                return quic.reason();
+            }
+            if let Some(h2) = inner.downcast_ref::<h2::Error>() {
+                return Self::from_h2_error(h2);
+            }
+        }
+        Self::from_plain_io_error(e)
+    }
+
+    fn from_h2_error(e: &h2::Error) -> Self {
+        if let Some(io) = e.get_io() {
+            return Self::from_plain_io_error(io);
+        }
+        let by = if e.is_remote() {
+            Side::Client
+        } else {
+            Side::Server
+        };
+        match e.reason() {
+            None => Self::PeerClosed { code: None },
+            Some(r) if r == h2::Reason::NO_ERROR => Self::PeerClosed { code: Some(0) },
+            Some(r) => Self::ProtocolError {
+                by,
+                code: u32::from(r) as u64,
+                app: false,
+            },
+        }
+    }
+
+    fn from_plain_io_error(e: &io::Error) -> Self {
+        if e.raw_os_error() == Some(libc::ETIMEDOUT) {
+            return Self::KeepaliveTimeout;
+        }
+        match e.kind() {
+            ErrorKind::UnexpectedEof => Self::PeerClosed { code: None },
+            ErrorKind::ConnectionReset | ErrorKind::ConnectionAborted | ErrorKind::BrokenPipe => {
+                Self::PeerReset
+            }
+            ErrorKind::InvalidData => Self::TlsError {
+                by: Side::Server,
+                code: None,
+            },
+            ErrorKind::PermissionDenied => Self::AuthRejected("connection limit"),
+            kind => Self::Io(kind),
+        }
+    }
+
+    fn name(&self) -> &'static str {
+        match self {
+            Self::PeerClosed { .. } => "closed_by_peer",
+            Self::PeerReset => "reset_by_peer",
+            Self::IdleTimeout(_) => "idle_timeout",
+            Self::QuicIdleTimeout(_) => "quic_idle_timeout",
+            Self::KeepaliveTimeout => "keepalive_timeout",
+            Self::TlsError { .. } => "tls_error",
+            Self::ProtocolError { .. } => "protocol_error",
+            Self::Shutdown => "server_shutdown",
+            Self::AuthRejected(_) => "auth_rejected",
+            Self::Io(_) => "io_error",
+        }
+    }
+}
+
+impl Display for CloseReason {
+    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
+        let side = |s: &Side| match s {
+            Side::Client => "client",
+            Side::Server => "server",
+        };
+        write!(f, "reason={}", self.name())?;
+        match self {
+            Self::PeerClosed { code: Some(c) } => write!(f, " code={:#x}", c),
+            Self::IdleTimeout(d) | Self::QuicIdleTimeout(d) => {
+                write!(f, " after={}s", d.as_secs())
+            }
+            Self::TlsError { by, code } => {
+                write!(f, " by={}", side(by))?;
+                match code {
+                    Some(c) => write!(f, " code={:#x}", c),
+                    None => Ok(()),
+                }
+            }
+            Self::ProtocolError { by, code, app } => write!(
+                f,
+                " by={} code={:#x}{}",
+                side(by),
+                code,
+                if *app { " app" } else { "" }
+            ),
+            Self::AuthRejected(why) => write!(f, " detail=\"{}\"", why),
+            Self::Io(kind) => write!(f, " kind={:?}", kind),
+            _ => Ok(()),
+        }
+    }
+}
+
+/// Counters of a client session, shared with the per-request tasks
+#[derive(Default)]
+pub(crate) struct SessionStats {
+    pub bytes_up: AtomicU64,
+    pub bytes_down: AtomicU64,
+    pub streams: AtomicU64,
+    pub auth_failures: AtomicU64,
+}
+
+/// Tracks a client session from creation until it is closed and logs the close record
+pub(crate) struct SessionRecord {
+    sid: u32,
+    protocol: Protocol,
+    started: Instant,
+    user_tag: Option<String>,
+    pub stats: Arc<SessionStats>,
+    active_sessions: Arc<AtomicU64>,
+}
+
+impl SessionRecord {
+    pub fn new(protocol: Protocol, active_sessions: Arc<AtomicU64>) -> Self {
+        active_sessions.fetch_add(1, Ordering::Relaxed);
+        Self {
+            sid: rand::random(),
+            protocol,
+            started: Instant::now(),
+            user_tag: None,
+            stats: Default::default(),
+            active_sessions,
+        }
+    }
+
+    pub fn has_user(&self) -> bool {
+        self.user_tag.is_some()
+    }
+
+    /// Remember the session owner as a short digest of the username, never the name itself
+    pub fn set_user(&mut self, username: &str) {
+        self.user_tag = Some(user_tag(username));
+    }
+
+    /// Format the close record. Returns `None` for sessions closed by an endpoint shutdown,
+    /// which are reported once in a summary instead.
+    pub fn close_line(&self, reason: &CloseReason) -> Option<String> {
+        if *reason == CloseReason::Shutdown {
+            return None;
+        }
+        Some(format!(
+            "Session closed: sid={:08x} proto={} user={} duration={:.1}s {} bytes_up={} bytes_down={} streams={} auth_failures={}",
+            self.sid,
+            proto_name(self.protocol),
+            self.user_tag.as_deref().unwrap_or("-"),
+            self.started.elapsed().as_secs_f64(),
+            reason,
+            self.stats.bytes_up.load(Ordering::Relaxed),
+            self.stats.bytes_down.load(Ordering::Relaxed),
+            self.stats.streams.load(Ordering::Relaxed),
+            self.stats.auth_failures.load(Ordering::Relaxed),
+        ))
+    }
+}
+
+impl Drop for SessionRecord {
+    fn drop(&mut self) {
+        self.active_sessions.fetch_sub(1, Ordering::Relaxed);
+    }
+}
+
+fn proto_name(protocol: Protocol) -> &'static str {
+    match protocol {
+        Protocol::Http1 => "h1",
+        Protocol::Http2 => "h2",
+        Protocol::Http3 => "h3",
+    }
+}
+
+fn user_tag(username: &str) -> String {
+    let digest = ring::digest::digest(&ring::digest::SHA256, username.as_bytes());
+    format!("u:{}", hex::encode(&digest.as_ref()[..4]))
+}
+
+/// Describe the timeouts which may close an idle client session
+pub(crate) fn timeouts_line(settings: &Settings) -> String {
+    format!(
+        "Session timeouts: client_listener_timeout={}s (closes h2/h3 sessions without new tunnel requests; also QUIC max_idle_timeout, closes h3 sessions without packets), tls_handshake_timeout={}s, tcp_connections_timeout={}s, udp_connections_timeout={}s, tcp_keepalive=on ({})",
+        settings.client_listener_timeout.as_secs(),
+        settings.tls_handshake_timeout.as_secs(),
+        settings.tcp_connections_timeout.as_secs(),
+        settings.udp_connections_timeout.as_secs(),
+        tcp_keepalive_params(),
+    )
+}
+
+fn tcp_keepalive_params() -> String {
+    let read = |name: &str| {
+        std::fs::read_to_string(format!("/proc/sys/net/ipv4/{}", name))
+            .ok()
+            .map(|s| s.trim().to_string())
+    };
+    match (
+        read("tcp_keepalive_time"),
+        read("tcp_keepalive_intvl"),
+        read("tcp_keepalive_probes"),
+    ) {
+        (Some(time), Some(intvl), Some(probes)) => {
+            format!("idle={}s interval={}s probes={}", time, intvl, probes)
+        }
+        _ => "OS defaults".to_string(),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn record() -> SessionRecord {
+        SessionRecord::new(Protocol::Http3, Default::default())
+    }
+
+    #[test]
+    fn peer_close_eof() {
+        let e = io::Error::from(ErrorKind::UnexpectedEof);
+        assert_eq!(
+            CloseReason::from_io_error(&e),
+            CloseReason::PeerClosed { code: None }
+        );
+    }
+
+    #[test]
+    fn peer_close_h2_goaway_no_error() {
+        let e = io::Error::new(
+            ErrorKind::UnexpectedEof,
+            h2::Error::from(h2::Reason::NO_ERROR),
+        );
+        assert_eq!(
+            CloseReason::from_io_error(&e),
+            CloseReason::PeerClosed { code: Some(0) }
+        );
+    }
+
+    #[test]
+    fn h2_protocol_error_has_code() {
+        let e = io::Error::other(h2::Error::from(h2::Reason::ENHANCE_YOUR_CALM));
+        let reason = CloseReason::from_io_error(&e);
+        assert_eq!(
+            reason,
+            CloseReason::ProtocolError {
+                by: Side::Server,
+                code: 0xb,
+                app: false
+            }
+        );
+        assert_eq!(
+            reason.to_string(),
+            "reason=protocol_error by=server code=0xb"
+        );
+    }
+
+    #[test]
+    fn peer_reset() {
+        for kind in [
+            ErrorKind::ConnectionReset,
+            ErrorKind::ConnectionAborted,
+            ErrorKind::BrokenPipe,
+        ] {
+            assert_eq!(
+                CloseReason::from_io_error(&io::Error::from(kind)),
+                CloseReason::PeerReset
+            );
+        }
+    }
+
+    #[test]
+    fn keepalive_timeout() {
+        let e = io::Error::from_raw_os_error(libc::ETIMEDOUT);
+        assert_eq!(
+            CloseReason::from_io_error(&e),
+            CloseReason::KeepaliveTimeout
+        );
+    }
+
+    #[test]
+    fn tls_error() {
+        let e = io::Error::new(ErrorKind::InvalidData, "bad record mac");
+        assert_eq!(
+            CloseReason::from_io_error(&e),
+            CloseReason::TlsError {
+                by: Side::Server,
+                code: None
+            }
+        );
+    }
+
+    #[test]
+    fn connection_limit() {
+        let e = io::Error::new(ErrorKind::PermissionDenied, "Connection limit exceeded");
+        assert_eq!(
+            CloseReason::from_io_error(&e),
+            CloseReason::AuthRejected("connection limit")
+        );
+    }
+
+    #[test]
+    fn other_io_error() {
+        let e = io::Error::from(ErrorKind::OutOfMemory);
+        assert_eq!(
+            CloseReason::from_io_error(&e).to_string(),
+            "reason=io_error kind=OutOfMemory"
+        );
+    }
+
+    #[test]
+    fn quic_idle_timeout() {
+        let e = QuicCloseInfo {
+            timed_out: true,
+            idle_timeout: Duration::from_secs(600),
+            ..Default::default()
+        }
+        .into_io_error();
+        let reason = CloseReason::from_io_error(&e);
+        assert_eq!(
+            reason,
+            CloseReason::QuicIdleTimeout(Duration::from_secs(600))
+        );
+        assert_eq!(reason.to_string(), "reason=quic_idle_timeout after=600s");
+    }
+
+    #[test]
+    fn quic_peer_close() {
+        for (app, code) in [(false, 0), (true, H3_NO_ERROR)] {
+            let e = QuicCloseInfo {
+                peer_error: Some((app, code)),
+                ..Default::default()
+            }
+            .into_io_error();
+            assert_eq!(
+                CloseReason::from_io_error(&e),
+                CloseReason::PeerClosed { code: Some(code) }
+            );
+        }
+    }
+
+    #[test]
+    fn quic_peer_tls_error() {
+        let e = QuicCloseInfo {
+            peer_error: Some((false, 0x12a)),
+            ..Default::default()
+        }
+        .into_io_error();
+        assert_eq!(
+            CloseReason::from_io_error(&e).to_string(),
+            "reason=tls_error by=client code=0x12a"
+        );
+    }
+
+    #[test]
+    fn quic_peer_app_error() {
+        let e = QuicCloseInfo {
+            peer_error: Some((true, 0x102)),
+            ..Default::default()
+        }
+        .into_io_error();
+        assert_eq!(
+            CloseReason::from_io_error(&e).to_string(),
+            "reason=protocol_error by=client code=0x102 app"
+        );
+    }
+
+    #[test]
+    fn quic_local_error() {
+        let e = QuicCloseInfo {
+            local_error: Some((false, 0x42)),
+            ..Default::default()
+        }
+        .into_io_error();
+        assert_eq!(
+            CloseReason::from_io_error(&e),
+            CloseReason::ProtocolError {
+                by: Side::Server,
+                code: 0x42,
+                app: false
+            }
+        );
+    }
+
+    #[test]
+    fn idle_timeout_line() {
+        let mut r = record();
+        r.stats.bytes_up.store(1234, Ordering::Relaxed);
+        r.stats.bytes_down.store(56789, Ordering::Relaxed);
+        r.stats.streams.store(7, Ordering::Relaxed);
+        r.set_user("alice@example.com");
+        let line = r
+            .close_line(&CloseReason::IdleTimeout(Duration::from_secs(600)))
+            .unwrap();
+        assert!(line.starts_with("Session closed: sid="), "{}", line);
+        assert!(line.contains(" proto=h3 "), "{}", line);
+        assert!(
+            line.contains(" reason=idle_timeout after=600s "),
+            "{}",
+            line
+        );
+        assert!(
+            line.ends_with("bytes_up=1234 bytes_down=56789 streams=7 auth_failures=0"),
+            "{}",
+            line
+        );
+        assert!(!line.contains("alice"), "{}", line);
+        assert!(line.contains(&user_tag("alice@example.com")), "{}", line);
+    }
+
+    #[test]
+    fn close_line_has_no_ip_address() {
+        let ips = ["192.0.2.17", "2001:db8::1", "::ffff:192.0.2.17"];
+        let reasons = [
+            CloseReason::PeerClosed { code: Some(0) },
+            CloseReason::PeerReset,
+            CloseReason::IdleTimeout(Duration::from_secs(600)),
+            CloseReason::QuicIdleTimeout(Duration::from_secs(600)),
+            CloseReason::KeepaliveTimeout,
+            CloseReason::TlsError {
+                by: Side::Client,
+                code: Some(0x12a),
+            },
+            CloseReason::ProtocolError {
+                by: Side::Client,
+                code: 0x1,
+                app: false,
+            },
+            CloseReason::AuthRejected("connection limit"),
+            CloseReason::Io(ErrorKind::Other),
+        ];
+        let mut r = record();
+        r.set_user("192.0.2.17");
+        for reason in reasons {
+            let line = r.close_line(&reason).unwrap();
+            for ip in ips {
+                assert!(!line.contains(ip), "{}", line);
+            }
+            let has_ip = line
+                .split([' ', '='])
+                .any(|t| t.parse::<std::net::IpAddr>().is_ok());
+            assert!(!has_ip, "{}", line);
+        }
+    }
+
+    #[test]
+    fn shutdown_is_not_logged_per_session() {
+        assert!(record().close_line(&CloseReason::Shutdown).is_none());
+    }
+
+    #[test]
+    fn active_sessions_counter() {
+        let active = Arc::new(AtomicU64::new(0));
+        let a = SessionRecord::new(Protocol::Http2, active.clone());
+        let b = SessionRecord::new(Protocol::Http3, active.clone());
+        assert_eq!(active.load(Ordering::Relaxed), 2);
+        drop(a);
+        assert_eq!(active.load(Ordering::Relaxed), 1);
+        drop(b);
+        assert_eq!(active.load(Ordering::Relaxed), 0);
+    }
+
+    #[test]
+    fn session_ids_differ() {
+        assert_ne!(record().sid, record().sid);
+    }
+}
