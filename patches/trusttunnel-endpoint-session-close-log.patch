--- /dev/null
+++ b/lib/src/termination.rs
@@ -0,0 +1,59 @@
+use std::io;
+use std::thread::JoinHandle;
+
+fn sigterm_set() -> libc::sigset_t {
+    // SAFETY: `sigemptyset` initializes the set before `sigaddset` uses it
+    unsafe {
+        let mut set = std::mem::zeroed();
+        libc::sigemptyset(&mut set);
+        libc::sigaddset(&mut set, libc::SIGTERM);
+        set
+    }
+}
+
+fn set_sigterm_mask(how: libc::c_int) -> io::Result<()> {
+    let set = sigterm_set();
+    // SAFETY: `set` is a valid initialized signal set
+    match unsafe { libc::pthread_sigmask(how, &set, std::ptr::null_mut()) } {
+        0 => Ok(()),
+        e => Err(io::Error::from_raw_os_error(e)),
+    }
+}
+
+/// Block SIGTERM in the calling thread. Threads spawned afterwards inherit the mask,
+/// so this must be called before any other thread is started.
+pub fn block_sigterm() -> io::Result<()> {
+    set_sigterm_mask(libc::SIG_BLOCK)
+}
+
+/// Wait for SIGTERM on a dedicated thread, which does not depend on the async runtime.
+/// On the signal, log the line returned by `summary`, flush the logger and terminate
+/// the process by the default SIGTERM action, so the parent still sees the signal status.
+/// Requires [`block_sigterm`] to have been called first.
+pub fn spawn_sigterm_handler<F>(summary: F) -> io::Result<JoinHandle<()>>
+where
+    F: FnOnce() -> String + Send + 'static,
+{
+    std::thread::Builder::new()
+        .name("sigterm".to_string())
+        .spawn(move || {
+            let set = sigterm_set();
+            let mut signal = 0;
+            // SAFETY: `set` is a valid initialized signal set, `signal` is a valid output
+            if unsafe { libc::sigwait(&set, &mut signal) } != 0 {
+                error!("Waiting for SIGTERM failed");
+                return;
+            }
+            info!("{}", summary());
+            log::logger().flush();
+            // SAFETY: restoring the default disposition and re-raising the signal
+            // on this thread terminates the process as an unhandled SIGTERM would
+            unsafe {
+                libc::signal(libc::SIGTERM, libc::SIG_DFL);
+            }
+            let _ = set_sigterm_mask(libc::SIG_UNBLOCK);
+            unsafe {
+                libc::raise(libc::SIGTERM);
+            }
+        })
+}
