diff --git a/lib/src/session_log.rs b/lib/src/session_log.rs
new file mode 100644
index 0000000..5f99390
--- /dev/null
+++ b/lib/src/session_log.rs
@@ -0,0 +1,798 @@
+use crate::settings::Settings;
+use crate::tls_demultiplexer::Protocol;
+use crate::{log_id, log_utils};
+use once_cell::sync::Lazy;
+use std::collections::BTreeMap;
+use std::fmt::{Display, Formatter};
+use std::io;
+use std::io::ErrorKind;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::{Arc, Mutex, OnceLock};
+use std::time::{Duration, Instant};
+
+const H3_NO_ERROR: u64 = 0x100;
+const QUIC_CRYPTO_ERRORS: std::ops::RangeInclusive<u64> = 0x100..=0x1ff;
+
+/// Interval of the summary of closed sessions which never authenticated
+pub(crate) const UNAUTHENTICATED_REPORT_INTERVAL: Duration = Duration::from_secs(60);
+
+/// Key of the user tags. It is random per process, so tags cannot be reversed by hashing
+/// candidate usernames and are comparable only within one endpoint run.
+static USER_TAG_KEY: Lazy<ring::hmac::Key> = Lazy::new(|| {
+    ring::hmac::Key::generate(ring::hmac::HMAC_SHA256, &ring::rand::SystemRandom::new())
+        .expect("Couldn't generate the user tag key")
+});
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum Side {
+    Client,
+    Server,
+}
+
+/// Why a client session (one HTTP connection carrying a tunnel) ended
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) enum CloseReason {
+    /// Orderly close: EOF, GOAWAY or CONNECTION_CLOSE without an error code
+    PeerClosed { code: Option<u64> },
+    /// Transport reset or aborted by the client side
+    PeerReset,
+    /// No new tunnel requests within `client_listener_timeout`
+    IdleTimeout(Duration),
+    /// QUIC idle timeout expired: no packets from the client within the effective
+    /// idle timeout (the smaller of the server and the client values)
+    QuicIdleTimeout(Duration),
+    /// TCP keepalive probes or retransmissions went unanswered (ETIMEDOUT)
+    KeepaliveTimeout,
+    /// TLS error: an alert received from the client (`by: Client`, `code` is the alert)
+    /// or a TLS / QUIC crypto error
+    TlsError { by: Side, code: Option<u64> },
+    /// HTTP/2 GOAWAY or QUIC CONNECTION_CLOSE with an error code
+    ProtocolError { by: Side, code: u64, app: bool },
+    /// The endpoint is shutting down or restarting
+    Shutdown,
+    /// The session was closed because its credentials were rejected
+    AuthRejected(&'static str),
+    /// The HTTP library failed without a protocol code or an I/O error
+    Internal,
+    /// The session task ended without a close reason, e.g. it panicked or was cancelled
+    Aborted,
+    /// Any other I/O error
+    Io(ErrorKind),
+}
+
+/// Details of a closed QUIC connection, carried as the payload of the [`io::Error`]
+/// returned when the connection is closed
+#[derive(Debug, Default, Clone)]
+pub(crate) struct QuicCloseInfo {
+    pub timed_out: bool,
+    pub idle_timeout: Duration,
+    /// (is_app, error_code)
+    pub peer_error: Option<(bool, u64)>,
+    pub local_error: Option<(bool, u64)>,
+}
+
+impl Display for QuicCloseInfo {
+    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
+        write!(f, "QUIC connection closed: {:?}", self)
+    }
+}
+
+impl std::error::Error for QuicCloseInfo {}
+
+impl QuicCloseInfo {
+    pub fn into_io_error(self) -> io::Error {
+        io::Error::new(ErrorKind::UnexpectedEof, self)
+    }
+
+    fn reason(&self) -> CloseReason {
+        if self.timed_out {
+            return CloseReason::QuicIdleTimeout(self.idle_timeout);
+        }
+        let by_error = |side, (app, code): (bool, u64)| match (app, code) {
+            (false, 0) | (true, H3_NO_ERROR) | (true, 0) if side == Side::Client => {
+                CloseReason::PeerClosed { code: Some(code) }
+            }
+            (false, c) if QUIC_CRYPTO_ERRORS.contains(&c) => CloseReason::TlsError {
+                by: side,
+                code: Some(c),
+            },
+            (app, code) => CloseReason::ProtocolError {
+                by: side,
+                code,
+                app,
+            },
+        };
+        match (self.peer_error, self.local_error) {
+            (Some(e), _) => by_error(Side::Client, e),
+            (None, Some(e)) => by_error(Side::Server, e),
+            (None, None) => CloseReason::PeerClosed { code: None },
+        }
+    }
+}
+
+/// The QUIC idle timeout in effect: the smaller of the local and the peer
+/// `max_idle_timeout`, where zero means no limit (RFC 9000, section 10.1)
+pub(crate) fn effective_quic_idle_timeout(local: Duration, peer_ms: u64) -> Duration {
+    let peer = Duration::from_millis(peer_ms);
+    match (local.is_zero(), peer.is_zero()) {
+        (false, false) => local.min(peer),
+        (true, _) => peer,
+        (false, true) => local,
+    }
+}
+
+impl CloseReason {
+    /// Classify an error which ended the session listener
+    pub fn from_io_error(e: &io::Error) -> Self {
+        if let Some(inner) = e.get_ref() {
+            if let Some(quic) = inner.downcast_ref::<QuicCloseInfo>() {
+                return quic.reason();
+            }
+            if let Some(h2) = inner.downcast_ref::<h2::Error>() {
+                return Self::from_h2_error(h2);
+            }
+            if let Some(tls) = inner.downcast_ref::<rustls::Error>() {
+                return Self::from_tls_error(tls);
+            }
+        }
+        Self::from_plain_io_error(e)
+    }
+
+    fn from_h2_error(e: &h2::Error) -> Self {
+        if let Some(io) = e.get_io() {
+            return Self::from_io_error(io);
+        }
+        let by = if e.is_remote() {
+            Side::Client
+        } else {
+            Side::Server
+        };
+        match e.reason() {
+            None => Self::Internal,
+            Some(r) if r == h2::Reason::NO_ERROR => Self::PeerClosed { code: Some(0) },
+            Some(r) => Self::ProtocolError {
+                by,
+                code: u32::from(r) as u64,
+                app: false,
+            },
+        }
+    }
+
+    fn from_tls_error(e: &rustls::Error) -> Self {
+        match e {
+            rustls::Error::AlertReceived(alert) => Self::TlsError {
+                by: Side::Client,
+                code: Some(u8::from(*alert) as u64),
+            },
+            _ => Self::TlsError {
+                by: Side::Server,
+                code: None,
+            },
+        }
+    }
+
+    fn from_plain_io_error(e: &io::Error) -> Self {
+        if e.raw_os_error() == Some(libc::ETIMEDOUT) {
+            return Self::KeepaliveTimeout;
+        }
+        match e.kind() {
+            ErrorKind::UnexpectedEof => Self::PeerClosed { code: None },
+            ErrorKind::ConnectionReset | ErrorKind::ConnectionAborted | ErrorKind::BrokenPipe => {
+                Self::PeerReset
+            }
+            ErrorKind::PermissionDenied => Self::AuthRejected("connection limit"),
+            kind => Self::Io(kind),
+        }
+    }
+
+    fn name(&self) -> &'static str {
+        match self {
+            Self::PeerClosed { .. } => "closed_by_peer",
+            Self::PeerReset => "reset_by_peer",
+            Self::IdleTimeout(_) => "idle_timeout",
+            Self::QuicIdleTimeout(_) => "quic_idle_timeout",
+            Self::KeepaliveTimeout => "keepalive_timeout",
+            Self::TlsError { .. } => "tls_error",
+            Self::ProtocolError { .. } => "protocol_error",
+            Self::Shutdown => "server_shutdown",
+            Self::AuthRejected(_) => "auth_rejected",
+            Self::Internal => "internal_error",
+            Self::Aborted => "aborted",
+            Self::Io(_) => "io_error",
+        }
+    }
+}
+
+impl Display for CloseReason {
+    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
+        let side = |s: &Side| match s {
+            Side::Client => "client",
+            Side::Server => "server",
+        };
+        write!(f, "reason={}", self.name())?;
+        match self {
+            Self::PeerClosed { code: Some(c) } => write!(f, " code={:#x}", c),
+            Self::IdleTimeout(d) | Self::QuicIdleTimeout(d) => {
+                write!(f, " after={}s", d.as_secs())
+            }
+            Self::TlsError { by, code } => {
+                write!(f, " by={}", side(by))?;
+                match code {
+                    Some(c) => write!(f, " code={:#x}", c),
+                    None => Ok(()),
+                }
+            }
+            Self::ProtocolError { by, code, app } => write!(
+                f,
+                " by={} code={:#x}{}",
+                side(by),
+                code,
+                if *app { " app" } else { "" }
+            ),
+            Self::AuthRejected(why) => write!(f, " detail=\"{}\"", why),
+            Self::Io(kind) => write!(f, " kind={:?}", kind),
+            _ => Ok(()),
+        }
+    }
+}
+
+/// Counters of a client session, shared with the per-request tasks
+#[derive(Default)]
+pub(crate) struct SessionStats {
+    pub bytes_up: AtomicU64,
+    pub bytes_down: AtomicU64,
+    pub streams: AtomicU64,
+    pub auth_failures: AtomicU64,
+    authenticated: AtomicBool,
+    user_tag: OnceLock<String>,
+}
+
+impl SessionStats {
+    /// Mark the session as authenticated. `username` must come from credentials
+    /// which passed the authentication.
+    pub fn on_authenticated(&self, username: Option<&str>) {
+        self.authenticated.store(true, Ordering::Relaxed);
+        if let Some(username) = username {
+            let _ = self.user_tag.set(user_tag(username));
+        }
+    }
+}
+
+/// Counts closed sessions which never authenticated, so that scanners and rejected
+/// clients produce one periodic summary instead of a line per connection
+#[derive(Default)]
+pub(crate) struct UnauthenticatedCloses {
+    by_reason: Mutex<BTreeMap<&'static str, u64>>,
+}
+
+impl UnauthenticatedCloses {
+    fn add(&self, reason: &CloseReason) {
+        *self
+            .by_reason
+            .lock()
+            .unwrap()
+            .entry(reason.name())
+            .or_default() += 1;
+    }
+
+    /// Take the summary of the sessions counted since the previous call
+    pub fn take_summary(&self) -> Option<String> {
+        let counts = std::mem::take(&mut *self.by_reason.lock().unwrap());
+        if counts.is_empty() {
+            return None;
+        }
+        let total: u64 = counts.values().sum();
+        let details = counts
+            .iter()
+            .map(|(name, n)| format!("{}={}", name, n))
+            .collect::<Vec<_>>()
+            .join(" ");
+        Some(format!(
+            "Unauthenticated sessions closed: {} ({})",
+            total, details
+        ))
+    }
+}
+
+/// Tracks a client session from creation until it is closed and logs the close record
+pub(crate) struct SessionRecord {
+    sid: u32,
+    protocol: Protocol,
+    started: Instant,
+    pub stats: Arc<SessionStats>,
+    active_sessions: Arc<AtomicU64>,
+    unauthenticated: Arc<UnauthenticatedCloses>,
+    log_id: log_utils::IdChain<u64>,
+    finished: bool,
+}
+
+impl SessionRecord {
+    /// `auth_required` tells whether the endpoint has an authenticator; without one every
+    /// session counts as authenticated
+    pub fn new(
+        protocol: Protocol,
+        auth_required: bool,
+        active_sessions: Arc<AtomicU64>,
+        unauthenticated: Arc<UnauthenticatedCloses>,
+        log_id: log_utils::IdChain<u64>,
+    ) -> Self {
+        active_sessions.fetch_add(1, Ordering::Relaxed);
+        let stats = SessionStats::default();
+        if !auth_required {
+            stats.authenticated.store(true, Ordering::Relaxed);
+        }
+        Self {
+            sid: rand::random(),
+            protocol,
+            started: Instant::now(),
+            stats: Arc::new(stats),
+            active_sessions,
+            unauthenticated,
+            log_id,
+            finished: false,
+        }
+    }
+
+    /// Log the close record, once per session
+    pub fn close(&mut self, reason: CloseReason) {
+        if let Some(line) = self.finish(&reason) {
+            log_id!(info, self.log_id, "{}", line);
+        }
+    }
+
+    /// Finish the session and format its close record. Returns `None` if the session is
+    /// already finished, was closed by an endpoint shutdown (reported in a summary), or never
+    /// authenticated (counted in [`UnauthenticatedCloses`]).
+    fn finish(&mut self, reason: &CloseReason) -> Option<String> {
+        if std::mem::replace(&mut self.finished, true) || *reason == CloseReason::Shutdown {
+            return None;
+        }
+        if !self.stats.authenticated.load(Ordering::Relaxed) {
+            self.unauthenticated.add(reason);
+            return None;
+        }
+        Some(format!(
+            "Session closed: sid={:08x} proto={} user={} duration={:.1}s {} bytes_up={} bytes_down={} streams={} auth_failures={}",
+            self.sid,
+            proto_name(self.protocol),
+            self.stats.user_tag.get().map(String::as_str).unwrap_or("-"),
+            self.started.elapsed().as_secs_f64(),
+            reason,
+            self.stats.bytes_up.load(Ordering::Relaxed),
+            self.stats.bytes_down.load(Ordering::Relaxed),
+            self.stats.streams.load(Ordering::Relaxed),
+            self.stats.auth_failures.load(Ordering::Relaxed),
+        ))
+    }
+}
+
+impl Drop for SessionRecord {
+    fn drop(&mut self) {
+        self.close(CloseReason::Aborted);
+        self.active_sessions.fetch_sub(1, Ordering::Relaxed);
+    }
+}
+
+fn proto_name(protocol: Protocol) -> &'static str {
+    match protocol {
+        Protocol::Http1 => "h1",
+        Protocol::Http2 => "h2",
+        Protocol::Http3 => "h3",
+    }
+}
+
+fn user_tag(username: &str) -> String {
+    user_tag_with_key(&USER_TAG_KEY, username)
+}
+
+fn user_tag_with_key(key: &ring::hmac::Key, username: &str) -> String {
+    let tag = ring::hmac::sign(key, username.as_bytes());
+    format!("u:{}", hex::encode(&tag.as_ref()[..4]))
+}
+
+/// Describe the timeouts which may close an idle client session
+pub(crate) fn timeouts_line(settings: &Settings) -> String {
+    format!(
+        "Session timeouts: client_listener_timeout={}s (closes h2/h3 sessions without new tunnel requests), quic_max_idle_timeout={}s (h3 sessions without packets are closed after the smaller of this and the client's value), tls_handshake_timeout={}s, tcp_connections_timeout={}s, udp_connections_timeout={}s, tcp_keepalive=on ({})",
+        settings.client_listener_timeout.as_secs(),
+        settings.client_listener_timeout.as_secs(),
+        settings.tls_handshake_timeout.as_secs(),
+        settings.tcp_connections_timeout.as_secs(),
+        settings.udp_connections_timeout.as_secs(),
+        tcp_keepalive_params(),
+    )
+}
+
+fn tcp_keepalive_params() -> String {
+    let read = |name: &str| {
+        std::fs::read_to_string(format!("/proc/sys/net/ipv4/{}", name))
+            .ok()
+            .map(|s| s.trim().to_string())
+    };
+    match (
+        read("tcp_keepalive_time"),
+        read("tcp_keepalive_intvl"),
+        read("tcp_keepalive_probes"),
+    ) {
+        (Some(time), Some(intvl), Some(probes)) => {
+            format!("idle={}s interval={}s probes={}", time, intvl, probes)
+        }
+        _ => "OS defaults".to_string(),
+    }
+}
+
