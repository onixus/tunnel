+    /// TCP still uses the timeout: it has no separate keepalive path.
+    async fn next_request(
+        &mut self,
+    ) -> io::Result<Option<Box<dyn downstream::PendingMultiplexedRequest>>> {
+        if self.downstream.protocol() == Protocol::Http3 {
+            return self.downstream.listen().await;
+        }
+        match tokio::time::timeout(
+            self.context.settings.client_listener_timeout,
+            self.downstream.listen(),
+        )
