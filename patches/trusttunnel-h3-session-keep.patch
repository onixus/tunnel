 const QUIC_CONNECTION_CLOSE_CODE: u64 = 0x42;
 
+fn quic_close_class(error: &io::Error) -> &'static str {
+    // Session task already dropped its channel. Kind, not Display: the session
+    // log patch turns that drop into UnexpectedEof, and the raw try_send path
+    // is NotConnected ("Channel closed"). Neither is a protocol failure.
+    if error.kind() == ErrorKind::NotConnected || error.kind() == ErrorKind::UnexpectedEof {
+        return "channel_closed";
+    }
+    let text = error.to_string();
+    let Some(rest) = text.split("QUIC receive failure:").nth(1) else {
+        return "other";
+    };
+    match rest
+        .trim()
+        .split(|c: char| !c.is_ascii_alphanumeric() && c != '_')
+        .next()
+    {
+        Some("InvalidPacket") => "invalid_packet",
+        Some("InvalidFrame") => "invalid_frame",
+        Some("CryptoFail") => "crypto_fail",
+        Some("FlowControl") => "flow_control",
+        Some("FinalSize") => "final_size",
+        Some("KeyUpdate") => "key_update",
+        Some("Done") => "done",
+        Some("BufferTooShort") => "buffer_too_short",
+        Some("InvalidState") => "invalid_state",
+        Some("InvalidStreamState") => "invalid_stream_state",
+        Some("TlsFail") => "tls_fail",
+        Some(_) => "quic_recv_other",
+        None => "quic_recv_other",
+    }
+}
+
 type QuicConnection = quiche::Connection;
 
