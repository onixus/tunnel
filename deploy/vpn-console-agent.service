[Unit]
Description=VPN Console local privileged adapter
After=network-online.target docker.service h-ui.service
[Service]
Type=simple
EnvironmentFile=-/opt/vpn-console/console.env
ExecStart=/usr/bin/python3 /opt/vpn-console/routing_agent.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# Protocols can be installed from the console after the UI is deployed. The installer creates
# /var/lib/h-ui up front: a path missing at start stays read-only until the agent restarts.
ReadWritePaths=/run /opt/vpn-console /opt/amneziawg /opt/xray-cdn /var/lib/h-ui -/opt/rtrust-updates -/opt/trusttunnel-web -/root/hysteria-route-backups
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
[Install]
WantedBy=multi-user.target
